<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/profileName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" />
    <TextView android:id="@+id/profileSince" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#6B7280" android:layout_marginTop="4dp" />
    <Button android:id="@+id/logout" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Log out" android:layout_marginTop="24dp" />
</LinearLayout>
