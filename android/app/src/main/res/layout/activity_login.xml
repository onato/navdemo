<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
    <TextView android:id="@+id/loginTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sign in to NavDemo" android:textSize="24sp" android:layout_marginBottom="24dp" />
    <EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Username" android:inputType="textNoSuggestions" android:autofillHints="username" />
    <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Password" android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone" />
    <Button android:id="@+id/signIn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Sign in" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/loginError" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#B91C1C" android:layout_marginTop="12dp" android:visibility="gone" />
    <TextView android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Any username, password is demo" android:textColor="#6B7280" android:layout_marginTop="24dp" />
</LinearLayout>
